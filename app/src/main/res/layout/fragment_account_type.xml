<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:padding="24dp">

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="@dimen/back_button_height"
        android:layout_height="@dimen/back_button_height"
        android:background="@drawable/bg_circle_back"
        android:foreground="?attr/actionBarItemBackground"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_primary" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:text="@string/account_type_screen_title"
        android:textAppearance="@style/TextAppearance.App.HeadlineMedium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintWidth_percent="0.8" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:text="@string/account_type_screen_subtitle"
        android:textAppearance="@style/TextAppearance.App.BodyLarge"
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- Option: Normal User -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNormalUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xxlarge"
        app:cardBackgroundColor="@color/md_primary_lighter"
        app:cardCornerRadius="@dimen/corner_radius_medium"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:strokeColor="@color/md_primary"
        app:strokeWidth="3dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivUserIcon"
                android:layout_width="@dimen/account_type_icon_size"
                android:layout_height="@dimen/account_type_icon_size"
                android:layout_marginVertical="@dimen/spacing_xxlarge"
                android:layout_marginStart="@dimen/spacing_large"
                android:background="@drawable/bg_circle_back"
                android:backgroundTint="@color/md_primary_container"
                android:src="@drawable/ic_card_normal_user"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/md_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_large"
                android:layout_marginEnd="@dimen/spacing_xxlarge"
                android:orientation="vertical"
                android:paddingEnd="@dimen/spacing_xxlarge"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivUserIcon"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvUserTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/normal_user_card_type_title"
                    android:textAppearance="@style/TextAppearance.App.TitleMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/normal_user_card_type_subtitle"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <ImageView
                android:id="@+id/ivUserCheck"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="@dimen/spacing_large"
                android:src="@drawable/ic_check_circle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/md_primary" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Option: Organizer -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOrganizer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        app:cardCornerRadius="@dimen/corner_radius_medium"
        app:layout_constraintTop_toBottomOf="@id/cardNormalUser"
        app:strokeColor="@color/md_outline"
        app:strokeWidth="1dp"
        tools:cardBackgroundColor="@color/md_secondary_lighter">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivOrganizerIcon"
                android:layout_width="@dimen/account_type_icon_size"
                android:layout_height="@dimen/account_type_icon_size"
                android:layout_marginVertical="@dimen/spacing_xxlarge"
                android:layout_marginStart="@dimen/spacing_large"
                android:background="@drawable/bg_circle_back"
                android:backgroundTint="@color/md_secondary_container"
                android:paddingTop="@dimen/spacing_small"
                android:src="@drawable/ic_card_organizer"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/md_secondary" />


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_large"
                android:layout_marginEnd="@dimen/spacing_xxlarge"
                android:orientation="vertical"
                android:paddingEnd="@dimen/spacing_xxlarge"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivOrganizerIcon"
                app:layout_constraintTop_toTopOf="parent">


                <TextView
                    android:id="@+id/tvOrgTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/organize_user_card_title"
                    android:textAppearance="@style/TextAppearance.App.TitleMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/organize_user_card_subtitle"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <ImageView
                android:id="@+id/ivOrgCheck"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="@dimen/spacing_large"
                android:src="@drawable/ic_check_circle"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/md_secondary"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:text="@string/btn_continue"
        android:textAppearance="@style/TextAppearance.App.TitleMedium"
        android:textColor="@color/md_on_primary"
        app:backgroundTint="@color/md_primary"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
