<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/homeScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="100dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header Section -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:id="@+id/tvGreetingPrefix"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_back"
                        android:textAppearance="@style/TextAppearance.App.TitleLarge"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:textAppearance="@style/TextAppearance.App.TitleLarge"
                        app:layout_constraintBaseline_toBaselineOf="@id/tvGreetingPrefix"
                        app:layout_constraintEnd_toStartOf="@id/btnNotifications"
                        app:layout_constraintStart_toEndOf="@id/tvGreetingPrefix"
                        tools:text="Ali" />

                    <ImageButton
                        android:id="@+id/btnNotifications"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Notifications"
                        android:src="@drawable/ic_notifications"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvSubGreeting"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Discover amazing events around you"
                        android:textAppearance="@style/TextAppearance.App.BodyMedium"
                        android:textColor="@color/md_on_surface_variant"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvGreetingPrefix" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Search Bar -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_large"
                    android:layout_marginBottom="@dimen/spacing_large"
                    app:cardBackgroundColor="@color/md_surface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/md_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_large">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@string/search"
                            android:src="@drawable/ic_search"
                            app:tint="@color/md_on_surface_variant" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_medium"
                            android:layout_weight="1"
                            android:text="Search events, artists, venues..."
                            android:textAppearance="@style/TextAppearance.App.BodyMedium"
                            android:textColor="@color/md_on_surface_variant" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@string/filter"
                            android:src="@drawable/ic_filter"
                            app:tint="@color/md_on_surface_variant" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Calendar Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_large">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_medium"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMonthYear"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.App.TitleMedium"
                            android:textStyle="bold"
                            tools:text="May 2026" />

                        <ImageButton
                            android:id="@+id/btnPreviousWeek"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/previous_week"
                            android:padding="8dp"
                            android:src="@drawable/ic_chevron_left"
                            app:tint="@color/md_on_surface" />

                        <ImageButton
                            android:id="@+id/btnNextWeek"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/next_week"
                            android:padding="8dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/md_on_surface" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCalendar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:orientation="horizontal"
                        tools:listitem="@layout/item_calendar_day" />

                </LinearLayout>

                <!-- User Interest Categories Section -->
                <HorizontalScrollView
                    android:id="@+id/layoutCategoriesSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"
                    android:paddingHorizontal="@dimen/spacing_large"
                    android:scrollbars="none"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupCategories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:singleLine="true" />

                </HorizontalScrollView>

                <!-- Date Filtered Events Section -->
                <LinearLayout
                    android:id="@+id/layoutDateFilteredSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvDateFilteredTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/spacing_large"
                        android:layout_marginBottom="@dimen/spacing_medium"
                        android:textAppearance="@style/TextAppearance.App.TitleMedium"
                        android:textStyle="bold"
                        tools:text="Events on May 3" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDateFilteredEvents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_large"
                        tools:listitem="@layout/item_event_card" />

                    <!-- Empty state for date filtered -->
                    <TextView
                        android:id="@+id/tvDateFilteredEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/spacing_large"
                        android:gravity="center"
                        android:padding="@dimen/spacing_xlarge"
                        android:text="No events on this date"
                        android:textAppearance="@style/TextAppearance.App.BodyMedium"
                        android:textColor="@color/md_on_surface_variant"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Featured Events Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/spacing_large"
                        android:layout_marginBottom="@dimen/spacing_medium"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Featured Events"
                            android:textAppearance="@style/TextAppearance.App.TitleMedium"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="See all"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/md_primary" />
                    </LinearLayout>

                    <!-- Loading Indicator for Featured -->
                    <ProgressBar
                        android:id="@+id/progressBarFeatured"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="24dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFeatured"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_large"
                        tools:listitem="@layout/item_event_card" />

                </LinearLayout>


                <!-- Events Near You Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/spacing_large"
                        android:layout_marginBottom="@dimen/spacing_medium"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Events Near You"
                            android:textAppearance="@style/TextAppearance.App.TitleMedium"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="See all"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/md_primary" />
                    </LinearLayout>

                    <!-- Loading Indicator for Events Near You -->
                    <ProgressBar
                        android:id="@+id/progressBarNearYou"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="24dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvEventsNearYou"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_large"
                        tools:listitem="@layout/item_event_small" />

                </LinearLayout>

                <!-- Your Upcoming Tickets Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_large">

                    <LinearLayout
                        android:id="@+id/layoutYourEventsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_medium"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvYourEvents"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Your Upcoming Tickets"
                            android:textAppearance="@style/TextAppearance.App.TitleMedium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSeeAllEvents"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="See all"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/md_primary" />

                    </LinearLayout>

                    <!-- Loading Indicator for User Events -->
                    <ProgressBar
                        android:id="@+id/progressBarYourEvents"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="24dp"
                        android:visibility="gone" />

                    <!-- Your Events RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvYourEvents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_large"
                        android:nestedScrollingEnabled="false"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:listitem="@layout/item_event_upcoming"
                        tools:visibility="visible" />

                    <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyEvents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_large"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_xlarge"
                        android:visibility="visible"
                        tools:visibility="gone">

                        <TextView
                            android:id="@+id/tvEmptyStateTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_small"
                            android:text="No upcoming tickets"
                            android:textAppearance="@style/TextAppearance.App.TitleMedium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEmptyStateDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_medium"
                            android:gravity="center"
                            android:text="Explore events to find"
                            android:textAppearance="@style/TextAppearance.App.BodyMedium"
                            android:textColor="@color/text_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExploreEvents"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/spacing_xlarge"
                            android:text="Explore events"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            app:cornerRadius="24dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginHorizontal="@dimen/spacing_xlarge"
        android:layout_marginBottom="?actionBarSize"
        android:backgroundTint="@color/md_primary"
        android:text="@string/chat"
        android:textAppearance="@style/TextAppearance.App.LabelLarge"
        android:textColor="@color/md_on_primary"
        app:icon="@drawable/chat_add_on_24px"
        app:iconTint="@color/md_on_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>