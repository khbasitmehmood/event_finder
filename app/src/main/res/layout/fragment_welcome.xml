<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Bottom Background View (Replaces bottomSection layout container) -->
    <View
        android:id="@+id/bottomSectionBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvWelcomeTitle" />

    <!-- Top section background illustration -->
    <ImageView
        android:id="@+id/ivWelcomeIll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/welcome_ill"
        app:layout_constraintBottom_toTopOf="@+id/bottomSectionBg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top gradient -->
    <ImageView
        android:id="@+id/ivTopGradient"
        android:layout_width="0dp"
        android:layout_height="?actionBarSize"
        android:elevation="1dp"
        android:src="@drawable/gradient_top_welcome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- App Logo -->
    <ImageView
        android:id="@+id/img_app_logo"
        android:layout_width="wrap_content"
        android:layout_height="200dp"
        android:adjustViewBounds="true"
        android:elevation="1dp"
        android:src="@drawable/ic_launcher_foreground"
        app:layout_constraintBottom_toTopOf="@+id/bottomSectionBg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0" />

    <!-- Rounded bottom sheet overlapping effect -->
    <ImageView
        android:id="@+id/ivBottomSheetRounded"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:elevation="8dp"
        android:src="@drawable/bg_bottom_sheet_rounded"
        app:layout_constraintBottom_toTopOf="@+id/bottomSectionBg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- TEXTS AND BUTTONS (Bottom-up chained) -->

    <TextView
        android:id="@+id/tvWelcomeTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_xlarge"
        android:layout_marginBottom="@dimen/spacing_large"
        android:elevation="8dp"
        android:text="Discover events around you"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.App.HeadlineSmall"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tvWelcomeDesc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvWelcomeDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="@dimen/spacing_xxlarge"
        android:elevation="8dp"
        android:text="Find local events, book your spot, or create events for your audience."
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.App.BodyMedium"
        android:textColor="@color/text_secondary"
        app:layout_constraintBottom_toTopOf="@id/btnCreateAccount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreateAccount"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginHorizontal="@dimen/spacing_xlarge"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:text="@string/btn_create_account"
        android:textAppearance="@style/TextAppearance.App.TitleMedium"
        android:textColor="@color/md_on_primary"
        app:layout_constraintBottom_toTopOf="@id/btnLogin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xxlarge"
        android:text="@string/btn_login"
        android:textAppearance="@style/TextAppearance.App.TitleMedium"
        android:textColor="@color/md_primary"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
