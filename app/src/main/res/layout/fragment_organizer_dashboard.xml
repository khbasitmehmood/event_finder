<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboardScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_large"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvWelcomeBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_back"
                    android:textAppearance="@style/TextAppearance.App.TitleLarge"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvOrganizerName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:textAppearance="@style/TextAppearance.App.TitleLarge"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvWelcomeBack"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvWelcomeBack"
                    tools:text="Ali" />

                <TextView
                    android:id="@+id/tvWelcomeMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_message_for_organizer"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/md_on_surface_variant"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvWelcomeBack" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Calendar Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/calendarLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/headerLayout">

                <TextView
                    android:id="@+id/tvMonthYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_large"
                    android:layout_marginBottom="8dp"
                    android:textAppearance="@style/TextAppearance.App.TitleMedium"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/headerLayout"
                    tools:text="May 2024" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_large"
                    android:layout_marginBottom="@dimen/spacing_xlarge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvMonthYear">

                    <ImageButton
                        android:id="@+id/btnPreviousWeek"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/previous_week"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="@color/md_on_surface" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCalendar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        tools:listitem="@layout/item_calendar_day"
                        tools:visibility="gone" />

                    <ImageButton
                        android:id="@+id/btnNextWeek"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/next_week"
                        android:src="@drawable/ic_next"
                        app:tint="@color/md_on_surface" />

                </LinearLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Empty Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/emptyLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxlarge"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/calendarLayout">

                <ImageView
                    android:id="@+id/ivEmptyPlaceHolder"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/illustration_size"
                    android:adjustViewBounds="true"
                    android:src="@drawable/ill_empty_event"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvEmptyStateMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_large"
                    android:gravity="center"
                    android:text="@string/organizer_home_empty_title"
                    android:textAppearance="@style/TextAppearance.App.TitleMedium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivEmptyPlaceHolder" />

                <TextView
                    android:id="@+id/tvEmptyStateSubMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:gravity="center"
                    android:text="@string/organizer_home_empty_subtitle"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvEmptyStateMessage" />

                <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                    android:id="@+id/btnCreateEventEmptyState"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginHorizontal="@dimen/spacing_xxlarge"
                    android:layout_marginVertical="@dimen/spacing_large"
                    android:text="@string/create_event"
                    android:textAppearance="@style/TextAppearance.App.LabelLarge"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvEmptyStateSubMessage" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Events Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/eventListLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/calendarLayout">

                <TextView
                    android:id="@+id/tvYourUpcomingEvents"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_large"
                    android:layout_weight="1"
                    android:text="@string/upcoming_events"
                    android:textAppearance="@style/TextAppearance.App.TitleMedium"
                    app:layout_constraintStart_toStartOf="parent" />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvUpcomingEvents"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_large"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvYourUpcomingEvents"
                    tools:listitem="@layout/item_event_card"
                    tools:visibility="gone" />

                <LinearLayout
                    android:id="@+id/eventStats"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/spacing_large"
                    android:weightSum="2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rvUpcomingEvents">


                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStatTicketsSold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_small"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/md_primary_lighter"
                        app:cardCornerRadius="@dimen/corner_radius_medium">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/spacing_large"
                            android:paddingVertical="@dimen/spacing_medium">

                            <TextView
                                android:id="@+id/tvTicketsSoldValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="12"
                                android:textAppearance="@style/TextAppearance.App.HeadlineMedium"
                                android:textColor="@color/md_primary" />

                            <TextView
                                android:id="@+id/tvTicketsSoldLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tickets Sold"
                                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                                android:textColor="@color/md_primary" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStatAttendees"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/md_secondary_lighter"
                        app:cardCornerRadius="@dimen/corner_radius_medium">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/spacing_large"
                            android:paddingVertical="@dimen/spacing_medium">

                            <TextView
                                android:id="@+id/tvAttendeeValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="56"
                                android:textAppearance="@style/TextAppearance.App.HeadlineMedium"
                                android:textColor="@color/md_secondary" />

                            <TextView
                                android:id="@+id/tvAttendeeLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="People Attending"
                                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                                android:textColor="@color/md_secondary" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanTicket"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginHorizontal="@dimen/spacing_large"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:elevation="0dp"
                    android:text="@string/scan_ticket"
                    android:textAppearance="@style/TextAppearance.App.LabelLarge"
                    app:backgroundTint="@color/md_secondary"
                    app:cornerRadius="@dimen/corner_radius_small"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_qr_scan"
                    app:iconGravity="textStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/eventStats" />


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/creatMoreEventsCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_large"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/md_primary"
                    app:cardCornerRadius="@dimen/corner_radius_small"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnScanTicket"
                    app:strokeWidth="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/spacing_large"
                            android:gravity="start"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/spacing_medium"
                            app:layout_constraintEnd_toStartOf="@+id/ivCreateEventArrow"
                            app:layout_constraintStart_toStartOf="parent">

                            <TextView
                                android:id="@+id/tvCreateMoreEventTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xxlarge"
                                android:text="@string/create_event"
                                android:textAppearance="@style/TextAppearance.App.TitleMedium"
                                android:textColor="@color/md_on_primary" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:adjustViewBounds="true"
                                    android:src="@drawable/ic_tip"
                                    android:tint="@color/yellow_golden" />

                                <TextView
                                    android:id="@+id/tvCreateTip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="You can save drafts and publish your event later"
                                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                                    android:textColor="@color/md_on_primary" />

                            </LinearLayout>


                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivCreateEventArrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/spacing_large"
                            android:src="@drawable/ic_arrow_forward"
                            android:tint="@color/md_on_primary"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginHorizontal="@dimen/spacing_xlarge"
        android:layout_marginBottom="?actionBarSize"
        android:backgroundTint="@color/md_primary"
        android:text="@string/chat"
        android:textAppearance="@style/TextAppearance.App.LabelLarge"
        android:textColor="@color/md_on_primary"
        android:visibility="gone"
        app:icon="@drawable/chat_add_on_24px"
        app:iconTint="@color/md_on_primary"
        tools:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>