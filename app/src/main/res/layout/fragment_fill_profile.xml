<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_xlarge">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/back_button_height"
            android:layout_height="@dimen/back_button_height"
            android:background="@drawable/bg_circle_back"
            android:foreground="?attr/actionBarItemBackground"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:text="@string/fill_profile_user_title"
            android:textAppearance="@style/TextAppearance.App.HeadlineMedium"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnBack" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/fill_profile_user_subtitle"
            android:textAppearance="@style/TextAppearance.App.BodyLarge"
            android:textColor="@color/text_secondary"
            app:layout_constraintStart_toStartOf="@+id/tvTitle"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintWidth_percent="0.7" />

        <!-- Profile Image -->
        <FrameLayout
            android:id="@+id/flProfileImage"
            android:layout_width="@dimen/fill_profile_photo_size"
            android:layout_height="@dimen/fill_profile_photo_size"
            android:layout_marginTop="@dimen/spacing_xxlarge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <ImageView
                android:id="@+id/ivProfileImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/profile_circle_bg"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/fill_profile_photo_badge_size"
                android:layout_height="@dimen/fill_profile_photo_badge_size"
                android:layout_gravity="bottom|end"
                app:cardBackgroundColor="@color/md_primary"
                app:cardCornerRadius="@dimen/fill_profile_photo_badge_corner_radius"
                app:cardElevation="@dimen/fill_profile_photo_badge_elevation"
                app:strokeColor="@color/md_surface"
                app:strokeWidth="@dimen/fill_profile_photo_badge_stroke_width">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/fill_profile_photo_badge_icon_padding"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="@color/md_on_primary" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Common Fields (Name & City) -->
        <LinearLayout
            android:id="@+id/llCommonFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxlarge"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/flProfileImage">

            <TextView
                android:id="@+id/tvNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:text="@string/hint_full_name"
                android:textAppearance="@style/TextAppearance.App.TitleSmall" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="none"
                app:errorEnabled="true"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_pill"
                    android:hint="@string/hint_full_name"
                    android:inputType="textPersonName"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>


            <!-- Organizer Phone (Hidden for normal user) -->
            <TextView
                android:id="@+id/tvContactLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:text="@string/hint_contact_number"
                android:textAppearance="@style/TextAppearance.App.TitleSmall"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:boxBackgroundMode="none"
                app:errorEnabled="true"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_pill"
                    android:hint="@string/fill_profile_hint_phone_optional"
                    android:inputType="phone"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvCityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:text="@string/fill_profile_hint_city"
                android:textAppearance="@style/TextAppearance.App.TitleSmall" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="none"
                app:helperText="@string/fill_profile_lahore_service_caption"
                app:helperTextTextAppearance="@style/TextAppearance.App.BodySmall"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_pill"
                    android:enabled="false"
                    android:focusable="false"
                    android:hint="@string/fill_profile_hint_city"
                    android:inputType="text"
                    android:text="Lahore"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Organizer Bio (Hidden for normal user) -->
            <TextView
                android:id="@+id/tvDescriptionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:text="@string/hint_org_description"
                android:layout_marginTop="@dimen/spacing_large"
                android:textAppearance="@style/TextAppearance.App.TitleSmall"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:boxBackgroundMode="none"
                app:errorEnabled="true"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_pill"
                    android:gravity="top|start"
                    android:hint="@string/fill_profile_hint_org_bio"
                    android:inputType="textMultiLine"
                    android:lines="3"
                    android:maxLength="120"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Normal User: Use Location Switch -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUseLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/llCommonFields"
            app:strokeColor="@color/md_outline"
            app:strokeWidth="@dimen/fill_profile_card_stroke_width">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_large">

                <TextView
                    android:id="@+id/tvUseLocationTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/fill_profile_use_location"
                    android:textAppearance="@style/TextAppearance.App.TitleMedium"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvUseLocationSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/fill_profile_use_location_subtitle"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvUseLocationTitle" />

                <TextView
                    android:id="@+id/tvSelectedLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                    android:textColor="@color/md_primary"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@id/switchLocation"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvUseLocationSubtitle" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_xxlarge"
            android:text="@string/btn_continue"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.App.TitleMedium"
            android:textColor="@color/md_on_primary"
            app:backgroundTint="@color/md_primary"
            app:cornerRadius="@dimen/corner_radius_large"
            app:layout_constraintTop_toBottomOf="@id/cardUseLocation" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tvManualLocation"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_xxlarge"
            android:text="@string/fill_profile_manual_location"
            android:textAppearance="@style/TextAppearance.App.TitleSmall"
            android:textColor="@color/md_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnSaveProfile" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/Widget.AppCompat.ProgressBar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:elevation="@dimen/spacing_small"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/btnSaveProfile"
            app:layout_constraintEnd_toEndOf="@id/btnSaveProfile"
            app:layout_constraintStart_toStartOf="@id/btnSaveProfile"
            app:layout_constraintTop_toTopOf="@id/btnSaveProfile" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
