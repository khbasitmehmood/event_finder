<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_large"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="@dimen/icon_size_large"
        android:layout_height="@dimen/icon_size_large"
        android:background="@drawable/bg_circle_avatar">
        <TextView
            android:id="@+id/tvInitials"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            tools:text="JS"
            android:textColor="?attr/colorOnSurface"
            android:textAppearance="@style/TextAppearance.App.TitleMedium"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/spacing_large">
        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Jane Smith"
            android:textColor="?attr/colorOnSurface"
            android:textAppearance="@style/TextAppearance.App.TitleMedium"/>
        <TextView
            android:id="@+id/tvTicketInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="2 x General Admission"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:layout_marginTop="@dimen/spacing_xsmall"/>
        <TextView
            android:id="@+id/tvBookingId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Booking ID: BK-1001"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="@style/TextAppearance.App.BodySmall"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Paid"
        android:textAppearance="@style/TextAppearance.App.LabelMedium"
        android:textColor="@color/md_primary"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingVertical="@dimen/spacing_small"
        android:background="@drawable/bg_tag_primary"
        android:layout_marginEnd="@dimen/spacing_medium"/>

    <ImageView
        android:layout_width="@dimen/spacing_large"
        android:layout_height="@dimen/spacing_large"
        android:src="@drawable/ic_arrow_right"
        android:contentDescription="@null"
        app:tint="?attr/colorOnSurfaceVariant"/>

</LinearLayout>