<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboardScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Good evening, "
                            android:textAppearance="@style/TextAppearance.App.TitleLarge"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOrganizerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.App.TitleLarge"
                            android:textStyle="bold"
                            tools:text="Ali" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" 👋"
                            android:textAppearance="@style/TextAppearance.App.TitleLarge"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Here's what's happening with your events"
                        android:textAppearance="@style/TextAppearance.App.BodyMedium"
                        android:textColor="@color/md_on_surface_variant" />
                </LinearLayout>

            </RelativeLayout>

            <!-- Month / Year -->
            <TextView
                android:id="@+id/tvMonthYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_large"
                android:layout_marginBottom="8dp"
                android:textAppearance="@style/TextAppearance.App.TitleMedium"
                android:textStyle="bold"
                tools:text="May 2024" />

            <!-- Calendar Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_xlarge"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPreviousWeek"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/previous_week"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/md_on_surface" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCalendar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    tools:listitem="@layout/item_calendar_day" />

                <ImageButton
                    android:id="@+id/btnNextWeek"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/next_week"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/md_on_surface" />

            </LinearLayout>

            <!-- Overview Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Overview"
                    android:textAppearance="@style/TextAppearance.App.TitleMedium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="This Month ∨"
                    android:textAppearance="@style/TextAppearance.App.LabelLarge"
                    android:textColor="@color/md_on_surface_variant" />

            </LinearLayout>

            <!-- Statistics Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_large"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Total Events Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTotalEvents"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="@color/md_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginBottom="16dp"
                            app:cardBackgroundColor="#00A96E"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">
                            <ImageView
                                android:id="@+id/ivEventsIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_events_stat"
                                app:tint="#FFFFFF"
                                android:contentDescription="@string/stat_icon" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvEventsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:textAppearance="@style/TextAppearance.App.HeadlineMedium"
                            android:textColor="@color/md_on_surface"
                            android:textStyle="bold"
                            android:text="12" />

                        <TextView
                            android:id="@+id/tvEventsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:textAppearance="@style/TextAppearance.App.BodyMedium"
                            android:textColor="@color/md_on_surface"
                            android:text="Total Events" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.App.BodySmall"
                            android:textColor="#00A96E"
                            android:text="2 new this month ↗" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Total Earnings Card -> Tickets Sold Card in mock -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTotalEarnings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="@color/md_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginBottom="16dp"
                            app:cardBackgroundColor="#FF9800"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">
                            <ImageView
                                android:id="@+id/ivEarningsIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_earnings"
                                app:tint="#FFFFFF"
                                android:contentDescription="@string/stat_icon" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvEarningsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:textAppearance="@style/TextAppearance.App.HeadlineMedium"
                            android:textColor="@color/md_on_surface"
                            android:textStyle="bold"
                            android:text="438" />

                        <TextView
                            android:id="@+id/tvEarningsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:textAppearance="@style/TextAppearance.App.BodyMedium"
                            android:textColor="@color/md_on_surface"
                            android:text="Tickets Sold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.App.BodySmall"
                            android:textColor="#00A96E"
                            android:text="18% vs last month ↗" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_xlarge"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateEventLarge"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Create Event"
                    android:textAppearance="@style/TextAppearance.App.LabelLarge"
                    android:backgroundTint="#00A96E"
                    android:textColor="#FFFFFF"
                    app:icon="@drawable/ic_add"
                    app:iconTint="#FFFFFF"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartEvent"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Scan Ticket"
                    android:textAppearance="@style/TextAppearance.App.LabelLarge"
                    android:textColor="#00A96E"
                    app:icon="@drawable/ic_filter"
                    app:iconTint="#00A96E"
                    app:strokeColor="#00A96E"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            <!-- Your Events Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_large">

                <LinearLayout
                    android:id="@+id/layoutYourEventsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvYourEvents"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="My Events"
                        android:textAppearance="@style/TextAppearance.App.TitleMedium"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSeeAllEvents"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="See all"
                        android:textAppearance="@style/TextAppearance.App.LabelLarge"
                        android:textColor="#00A96E"
                        android:visibility="visible" />

                </LinearLayout>

                <!-- Your Events RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvYourEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"
                    tools:listitem="@layout/item_event_upcoming"
                    tools:visibility="visible" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/layoutEmptyEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_xlarge"
                    android:visibility="visible"
                    tools:visibility="gone">

                    <TextView
                        android:id="@+id/tvEmptyStateTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_small"
                        android:text="No events"
                        android:textAppearance="@style/TextAppearance.App.TitleMedium" />

                    <TextView
                        android:id="@+id/tvEmptyStateDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_medium"
                        android:gravity="center"
                        android:text="Create your first event"
                        android:textAppearance="@style/TextAppearance.App.BodyMedium"
                        android:textColor="@color/md_on_surface_variant" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginHorizontal="@dimen/spacing_xlarge"
        android:layout_marginBottom="?actionBarSize"
        android:backgroundTint="@color/md_primary"
        android:text="@string/chat"
        android:textAppearance="@style/TextAppearance.App.LabelLarge"
        android:textColor="@color/md_on_primary"
        android:visibility="gone"
        app:icon="@drawable/chat_add_on_24px"
        app:iconTint="@color/md_on_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>