<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/event_detail_hero_height"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="false"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fitsSystemWindows="false"
            app:contentScrim="@android:color/transparent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:scrimAnimationDuration="0"
            app:titleEnabled="false">

            <!-- Hero Image -->
            <ImageView
                android:id="@+id/ivDetailImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fitsSystemWindows="false"
                android:scaleType="centerCrop"
                android:src="@drawable/event_img"
                app:layout_collapseMode="parallax" />

            <!-- Gradient overlay for text readability -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/event_detail_gradient_height"
                android:layout_gravity="bottom"
                android:background="@drawable/bottom_shadow_gradient"
                app:layout_collapseMode="parallax" />

            <!-- Invisible pinned toolbar keeps a stable collapsed height for CoordinatorLayout. -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/event_detail_toolbar_height"
                android:background="@android:color/transparent"
                android:minHeight="0dp"
                app:contentInsetEnd="0dp"
                app:contentInsetStart="0dp"
                app:layout_collapseMode="pin" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Curved Sheet: CoordinatorLayout moves this with the AppBar; inner content scrolls inside it. -->
    <FrameLayout
        android:id="@+id/stickySheetContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_detail_sheet"
        android:clipChildren="true"
        android:clipToPadding="false"
        android:elevation="@dimen/elevation_small"
        android:translationZ="@dimen/elevation_small"
        app:behavior_overlapTop="72dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingTop="@dimen/spacing_large"
            android:paddingBottom="@dimen/event_detail_scroll_padding_bottom">

            <!-- Main Content Container -->
            <LinearLayout
                android:id="@+id/contentLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="0dp"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_xlarge"
                android:paddingBottom="@dimen/spacing_xxlarge">

                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/spacing_large"
                    android:textAppearance="@style/TextAppearance.App.TitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    tools:text="Sunset Beats Festival: Coastal Music &amp; Food Weekend" />

                <!-- Date & Location Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">


                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/spacing_large_plus"
                        app:cardBackgroundColor="@color/md_surface_variant">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="center_vertical">


                            <ImageView
                                android:layout_width="@dimen/icon_size_medium"
                                android:layout_height="@dimen/icon_size_medium"
                                android:layout_gravity="center"
                                android:layout_marginStart="@dimen/spacing_large"
                                android:src="@drawable/ic_select_date"
                                app:tint="@color/md_primary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginVertical="@dimen/spacing_medium_large"
                                android:layout_marginStart="@dimen/spacing_large"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvDetailDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.App.LabelLarge"
                                    tools:text="Sat, 31 May 2025" />

                                <TextView
                                    android:id="@+id/tvDetailTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_xsmall"
                                    android:textAppearance="@style/TextAppearance.App.LabelSmall"
                                    tools:text="4:00 PM - 10:00 PM" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddCalendar"
                                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/spacing_large"
                                app:backgroundTint="@color/md_secondary_container"
                                app:cornerRadius="@dimen/corner_radius_medium_small"
                                app:icon="@drawable/ic_calendar_add"
                                app:iconTint="@color/md_secondary" />
                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- Location Row -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/spacing_large_plus"
                        app:cardBackgroundColor="@color/md_surface_variant">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="@dimen/icon_size_medium"
                                android:layout_height="@dimen/icon_size_medium"
                                android:layout_gravity="center"
                                android:layout_marginStart="@dimen/spacing_large"
                                android:src="@drawable/ic_location"
                                app:tint="@color/md_primary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginVertical="@dimen/spacing_medium_large"
                                android:layout_marginStart="@dimen/spacing_large"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/location"
                                    android:textAppearance="@style/TextAppearance.App.LabelLarge" />

                                <TextView
                                    android:id="@+id/tvDetailLocation"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_xsmall"
                                    android:textAppearance="@style/TextAppearance.App.LabelSmall"
                                    tools:text="Crissy Field, San Francisco, CA" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnOpenMap"
                                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/spacing_large"
                                app:backgroundTint="@color/md_secondary_container"
                                app:cornerRadius="@dimen/corner_radius_medium_small"
                                app:icon="@drawable/ic_directions"
                                app:iconTint="@color/md_secondary" />
                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


                <!-- Header Section: Tags -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_medium_large"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cgTags"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true" />
                </HorizontalScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:layout_marginBottom="@dimen/spacing_large"
                    android:background="?attr/colorOutlineVariant" />

                <!-- About Event -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_about_event"
                    android:textAppearance="@style/TextAppearance.App.TitleSmall" />

                <TextView
                    android:id="@+id/tvDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium_large"
                    android:lineSpacingMultiplier="1.4"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    tools:text="@string/lorem_ipsum" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:layout_marginVertical="@dimen/spacing_xxlarge"
                    android:background="?attr/colorOutlineVariant" />

                <!-- Organizer Profile Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_xlarge"
                    app:cardCornerRadius="@dimen/corner_radius_medium"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="@dimen/divider_height">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_large">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivOrganizerLogo"
                            android:layout_width="@dimen/icon_size_large"
                            android:layout_height="@dimen/icon_size_large"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_profile"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_large"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_organized_by"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="@dimen/text_size_xsmall" />

                            <TextView
                                android:id="@+id/tvOrganizerName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/text_size_body"
                                android:textStyle="bold"
                                tools:text="Beat Collective" />
                        </LinearLayout>

                        <!-- Visual Only Follow Button -->
                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="0dp"
                            android:text="@string/follow"
                            android:textColor="@color/md_primary"
                            app:rippleColor="@color/md_primary_container" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_detail_sheet_dark"
        android:elevation="@dimen/elevation_large"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_xlarge"
        android:paddingTop="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_xlarge">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_price"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_xsmall" />

            <TextView
                android:id="@+id/tvDetailPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_size_title_large"
                android:textStyle="bold"
                tools:text="Free" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_action_button_height"
            android:layout_weight="1.5"
            android:text="@string/book_now"
            android:textColor="@color/md_on_primary"
            android:textSize="@dimen/text_size_body"
            app:backgroundTint="@color/md_primary"
            app:cornerRadius="@dimen/corner_radius_medium" />
    </LinearLayout>

    <!-- Top Action Bar Overlay (Pinned Top) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/elevation_large"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_large"
        android:paddingTop="@dimen/spacing_top_overlay"
        android:paddingBottom="@dimen/spacing_large"
        android:translationZ="@dimen/elevation_large">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_btn_size"
            android:layout_height="@dimen/icon_btn_size"
            android:background="@drawable/bg_circle_back"
            android:src="@drawable/arrow_back_24px"
            app:tint="?attr/colorOnSurface" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="@dimen/icon_btn_size"
            android:layout_height="@dimen/icon_btn_size"
            android:layout_marginEnd="@dimen/spacing_medium_large"
            android:background="@drawable/bg_circle_back"
            android:src="@drawable/ic_share"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="@dimen/icon_btn_size"
            android:layout_height="@dimen/icon_btn_size"
            android:background="@drawable/bg_circle_back"
            android:src="@drawable/ic_favorite"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>